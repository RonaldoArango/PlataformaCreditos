<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PlataformaCreditos</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/PlataformaCreditos.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- NOMBRE DE LA PLATAFORMA -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    PlataformaCreditos
                </a>

                <!-- BOTÓN RESPONSIVE -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- MENÚ -->

                    <ul class="navbar-nav flex-grow-1">

                        <!-- INICIO -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <!-- MIS SOLICITUDES -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Solicitudes"
                                   asp-action="Index">

                                    Mis solicitudes

                                </a>

                            </li>


                            <!-- NUEVA SOLICITUD -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Solicitudes"
                                   asp-action="Create">

                                    Nueva solicitud

                                </a>

                            </li>


                            <!-- PANEL ANALISTA -->

                            @if (User.IsInRole("Analista"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Analista"
                                       asp-action="Index">

                                        Panel Analista

                                    </a>

                                </li>

                            }

                        }

                    </ul>


                    <!-- LOGIN / LOGOUT -->

                    <partial name="_LoginPartial" />


                    <!-- ÚLTIMA SOLICITUD -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        var ultimaSolicitudId =
                            Context.Session.GetInt32("UltimaSolicitudId");

                        var ultimaSolicitudMonto =
                            Context.Session.GetString("UltimaSolicitudMonto");


                        @if (ultimaSolicitudId.HasValue)
                        {

                            <a class="btn btn-outline-primary ms-3"
                               asp-controller="Solicitudes"
                               asp-action="Details"
                               asp-route-id="@ultimaSolicitudId">

                                Ver última solicitud
                                S/ @ultimaSolicitudMonto

                            </a>

                        }

                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- CONTENIDO -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - PlataformaCreditos

            -

            <a asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>